{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORACLE",
  "version": "0.4.2",
  "identifier": "com.emiliasingleton.oracle",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ORACLE",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Emilia Singleton",
    "category": "Lifestyle",
    "shortDescription": "An interactive archive of human memory.",
    "longDescription": "ORACLE is a desktop memory reconstruction archive with a luminous three-dimensional orbit, environmental context, acoustic imprints, and personal media specimens.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
